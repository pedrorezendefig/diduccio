# Copie para `.env.local` para rodar contra o Supabase.
#
# Estas duas variáveis são OBRIGATÓRIAS. Sem elas o app não sobe: o cliente do
# Supabase lança erro já na importação (src/api/supabase.js), o que na Vercel
# aparece como página em branco — o build passa normalmente, porque o erro só
# acontece quando o navegador executa. Se o site subir branco, é a primeira
# coisa a conferir.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# A publishable key (sb_publishable_*) é pública por natureza: ela vai compilada
# dentro do bundle e qualquer visitante consegue lê-la. Quem protege os dados é
# o RLS. A secret key (sb_secret_*) NUNCA entra aqui nem em nenhuma variável com
# prefixo VITE_ — o prefixo é justamente o que manda o Vite embutir o valor no
# JavaScript que vai para o navegador.

# ---------------------------------------------------------------------------
# Herança do Apps Script — ainda tem efeito, apesar de o backend antigo ter saído
# ---------------------------------------------------------------------------

# CUIDADO: hoje o modo demo é ligado por `VITE_DEMO=true` OU pela AUSÊNCIA de
# VITE_API_URL (src/api/config.js). Ou seja, um ambiente sem VITE_API_URL sobe
# com dados FICTÍCIOS e não avisa nada — as telas funcionam, os números são
# inventados. Em produção, mantenha VITE_API_URL preenchida com qualquer valor
# até esse acoplamento ser removido.
VITE_API_URL=

# Token do Apps Script. Não é mais usado para ler nem gravar nada.
VITE_SHEETS_TOKEN=

# Força o modo demo mesmo com backend configurado. Use "true" para apresentar.
VITE_DEMO=

# ---------------------------------------------------------------------------
# Só para scripts Node (não têm prefixo VITE_ e nunca chegam ao navegador)
# ---------------------------------------------------------------------------

# Chave secreta do Supabase. Ignora RLS: é acesso irrestrito ao banco.
SUPABASE_SECRET_KEY=

# Sal adicional usado na conferência das senhas antigas da planilha.
SENHA_PEPPER=
