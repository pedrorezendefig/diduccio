senhas-provisorias.txt

# Estado local da CLI do Supabase: guarda a qual projeto ESTA máquina está
# ligada. Não é segredo (o ref aparece na URL da API), mas é estado de máquina,
# não do projeto — versionar faz o link de um dev sobrescrever o do outro.
supabase/.temp/
